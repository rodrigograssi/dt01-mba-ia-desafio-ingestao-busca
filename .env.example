# Chave de API do OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Modelo de embedding (no OpenRouter use o prefixo do fornecedor)
# ATENCAO: a ingestao e o chat precisam usar o MESMO modelo.
MODEL_EMBEDDING=openai/text-embedding-3-small

# Modelo de chat usado para gerar as respostas
MODEL_LLM=openai/gpt-4o-mini

# Conexao com o Postgres + pgvector (mesmos dados do docker-compose.yml)
PG_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantica

# Nome da colecao onde os chunks sao gravados
PG_VECTOR_COLLECTION=documentos
